# Copy to .env (git-ignored) and fill in real values. Never commit .env.

POSTGRES_USER=ifleon
# Letters and digits only (it goes inside a connection URL). e.g. openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ifleon
POSTGRES_PORT=5433

DASHBOARD_PORT=3100
ADMIN_EMAIL=you@example.com
# Generate with: cd ../dashboard && npm run hash-password
ADMIN_PASSWORD_HASH=
# Random 32+ characters, e.g. openssl rand -hex 32
SESSION_SECRET=
DISPLAY_TIMEZONE=Asia/Kolkata
# Public address of the dashboard; uploaded image URLs start with this.
PUBLIC_BASE_URL=https://dashboard.ifleon.com

# AI writer. Providers are tried in this order; one without a key is skipped.
AI_PROVIDERS=gemini,nvidia
AI_DAILY_LIMIT=10
# Free key: https://aistudio.google.com/apikey  (model defaults to gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=
# Free key: https://build.nvidia.com  (model defaults to meta/llama-3.3-70b-instruct)
NVIDIA_API_KEY=
NVIDIA_MODEL=
