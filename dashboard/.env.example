# For running the dashboard outside Docker (`npm run dev`). Copy to .env.local.
# Inside Docker these come from backend/.env instead.

# Points at the Postgres container from backend/docker-compose.yml.
DATABASE_URL=postgres://ifleon:change-me@localhost:5433/ifleon

ADMIN_EMAIL=you@example.com
# Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=
# Any random string of 32+ characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=
